# =====================================================================
# Build trees (CMake out-of-source). Anything called build*/ is treated
# as throwaway. Recreate with `cmake -S . -B build_mkl ...` etc.
# =====================================================================
build/
build_*/
cmake-build-*/
out/

# CMake generated artefacts that may leak outside build/ on some setups.
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
Testing/
*.cmake.in.cache

# =====================================================================
# Solver run outputs. Each `--out <dir>` produces a self-contained
# results directory; they're regenerated by re-running the solver and
# bloat the history if committed.
# =====================================================================
results/
results_*/

# Loose output files written next to the binary on smoke runs.
*.crash.log
run.log
run.json
field_last.vtu
s_parameters.csv

# =====================================================================
# IDE / editor metadata.
# =====================================================================
.vs/
.vscode/
.idea/
*.suo
*.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# Visual Studio specific generated project files inside build trees are
# already covered by build_*/, but keep these as a safety net for
# accidental in-source generation.
*.vcxproj.user
*.aps
*.ncb

# =====================================================================
# Compiled object / library artefacts (must never appear in source tree
# under normal builds, but keep ignored for safety).
# =====================================================================
*.obj
*.o
*.lib
*.a
*.exe
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.exp
*.idb
*.tlog
*.recipe
*.lastbuildstate

# =====================================================================
# LaTeX intermediate files. The committed source is the .tex; .pdf
# is also kept (small, useful for review) but auxiliary files are not.
# =====================================================================
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.log
*.toc
*.out
*.lot
*.lof
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.dvi
*.xdv

# =====================================================================
# Python tooling (used by scripts/).
# =====================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env

# =====================================================================
# Backup / OS noise.
# =====================================================================
*.bak
*.swp
*.swo
*~
Thumbs.db
.DS_Store

# =====================================================================
# Project specific.
# =====================================================================
build_log.txt
*_stdout.log
*_stdout.txt
